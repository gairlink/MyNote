<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EDE9FF"
    android:padding="16dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌿  MyNote"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#3D3566" />
    <TextView android:id="@+id/widgetItem1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#3D3566"
        android:paddingTop="8dp" />
    <TextView android:id="@+id/widgetItem2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#3D3566" />
    <TextView android:id="@+id/widgetItem3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#3D3566" />
    <TextView android:id="@+id/widgetItem4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#3D3566" />
</LinearLayout>